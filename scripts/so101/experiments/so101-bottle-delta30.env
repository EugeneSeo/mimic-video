# SO-101 bottle 30Hz incremental-delta action-decoder setup.
# Keep this file user/path agnostic; paths are derived in scripts/so101/lib/paths.sh.

POLICY_EXPERIMENT_NAME="w2a_so101_delta_30hz_partial_bridge_init_v2w_bridge_lora_rank256_lr1.778e-04_bsz64_iter_000070043_fused_lr1.000e-04_layer20_bsz4"

SO101_DATASET_REPO="dreamdifferent/so101_bottle"
SO101_ACTION_DATASET_REPO="dreamdifferent/so101_bottle"
VIDEO_DATA_DIR_NAME="so101_bottle_front_wrist_hstack_5fps_full"
ACTION_ZARR_DIR_NAME="so101_bottle_action_only_full"

# Video preprocessing performs real temporal subsampling, not metadata-only FPS
# rewriting. For SO-101 30fps videos, TARGET_FPS=5 keeps every 6th frame.
SO101_VIDEO_SOURCE_FPS="30"
SO101_VIDEO_TARGET_FPS="5"
SO101_VIEW_LAYOUT="hstack"

# Action decoder timing. DATA_CONFIG is derived automatically from
# ACTION_TRANSFORM and SO101_ACTION_TARGET_FREQUENCY.
# The policy predicts 90 action deltas at 30Hz, i.e. a 3 second chunk.
# World2Action max_horizon is 91 because the model sequence is:
#   1 observed lowdim state + 90 predicted action targets.
ACTION_TRANSFORM="delta"
SO101_ACTION_TARGET_FREQUENCY="30"
SO101_ACTION_HORIZON="90"
SO101_W2A_MAX_HORIZON="91"

BASE_VIDEO_FILE="v2w_bridge_lora_rank256_lr1.778e-04_bsz64_iter_000070043_fused.pt"

MIMIC_VIDEO_NUM_SAMPLING_STEPS="35"
MIMIC_VIDEO_STOP_VIDEO_DENOISING_STEP="10"
MIMIC_VIDEO_NUM_VAL_EPISODES="10"

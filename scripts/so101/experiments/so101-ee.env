# SO-101 EE end-effector policy server experiment defaults.
export MVS_EXPERIMENT="so101-ee"
export POLICY_EXPERIMENT_NAME="w2a_so101_ee_v2w_bridge_lora_rank256_lr1.778e-04_bsz64_iter_000070043_fused_lr1.000e-04_layer20_bsz1"
export ACTION_DECODER_KIND="ee"

export BASE_VIDEO_FILE="v2w_bridge_lora_rank256_lr1.778e-04_bsz64_iter_000070043_fused.pt"
export VIDEO_LORA_FILE="checkpoints/model/iter_000001000.pt"
export ACTION_EE_FILE="checkpoints/model/iter_000002750.pt"
export ACTION_EE_STATS_FILE=".statistics_cache/38f88b27628b4953d3ba0c99452d845ed566224ad6b6f39d06fe6e685dec7084"

# paths.sh initializes MVS_EXP_ROOT from MVS_EXPERIMENT before sourcing this file.
# Use a separate override knob so the so101-ee alias still resolves to the
# actual training artifact directory by default.
export MVS_EXP_ROOT="${MVS_SO101_EE_EXP_ROOT:-${MVS_ROOT}/experiments/so101_hetero_ee}"
export MVS_SHARED_ACTION_DATA_DIR="${MVS_SHARED_DATA_ROOT}/so101_hetero_ee_action_30hz_full"
export MVS_SHARED_VIDEO_DATA_DIR="${MVS_SHARED_VIDEO_DATA_ROOT}/so101_hetero_front_wrist_hstack_5fps_full"
export MVS_EXP_VIDEO_LORA_DIR="${MVS_SHARED_CHECKPOINT_ROOT}/video_lora/so101_multi_object_2cam_hstack_5fps"
export MVS_EXP_ACTION_EE_DIR="${MVS_EXP_ROOT}/runs/action_decoder/vam/so101_ee/w2a_so101_ee_v2w_bridge_lora_rank256_lr1.778e-04_bsz64_iter_000070043_fused_lr1.000e-04_layer20_bsz1"

export MVS_VIDEO_BACKBONE_PATH="${MVS_SHARED_VIDEO_BACKBONE_DIR}/${BASE_VIDEO_FILE}"
export MVS_VIDEO_LORA_PATH="${MVS_EXP_VIDEO_LORA_DIR}/${VIDEO_LORA_FILE}"
export MVS_ACTION_MODEL_PATH="${MVS_EXP_ACTION_EE_DIR}/${ACTION_EE_FILE}"
export MVS_ACTION_STATS_PATH="${MVS_SHARED_ACTION_DATA_DIR}/${ACTION_EE_STATS_FILE}"

export MVS_NUM_SAMPLING_STEPS="${MVS_NUM_SAMPLING_STEPS:-35}"
export MVS_STOP_VIDEO_DENOISING_STEP="${MVS_STOP_VIDEO_DENOISING_STEP:-10}"
export MVS_NUM_VAL_EPISODES="${MVS_NUM_VAL_EPISODES:-10}"
export MVS_SERVER_USE_STATS="${MVS_SERVER_USE_STATS:-1}"
export MVS_SERVER_USE_PROMPT_CACHE="${MVS_SERVER_USE_PROMPT_CACHE:-0}"

export SO101_EE_DATA_DIR="${SO101_EE_DATA_DIR:-${MVS_SHARED_ACTION_DATA_DIR}}"
export SO101_VIDEO_DIR="${SO101_VIDEO_DIR:-${MVS_SHARED_VIDEO_DATA_DIR}}"
export SO101_VIDEO_FPS="${SO101_VIDEO_FPS:-5}"
